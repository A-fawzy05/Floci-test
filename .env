# Floci endpoint (local AWS emulator) and region
FLOCI_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1

# dummy creds — Floci does not check these, SDK just requires something present
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Cognito resources (create manually against Floci first)
COGNITO_USER_POOL_ID=us-east-1_57c23fa55
COGNITO_CLIENT_ID=297c4df61a4d403199d53d8c8c

# DynamoDB tables (create manually against Floci first)
DDB_USERS_TABLE=ChatUsers
DDB_MESSAGES_TABLE=ChatMessages

# S3 bucket (create manually against Floci first)
S3_BUCKET=chat-attachments

PORT=3000
